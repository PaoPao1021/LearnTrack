<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.learntrack.backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>source "$HOME/.learntrack-backup-env" 2>/dev/null; exec "$HOME/paopao/LearnTrack/scripts/backup/pull-backup-macos.sh"</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>21600</integer>
  <key>StandardOutPath</key>
  <string>/tmp/learntrack-backup.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/learntrack-backup.log</string>
</dict>
</plist>
