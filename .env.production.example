# Copy to .env.production on the Linux host. This file is intentionally not usable
# as-is: docker compose production refuses to start until every required value exists.

# A public DNS name with A/AAAA records pointing at this host. Do not include https://.
LT_DOMAIN=learntrack.example.com
LT_ACME_EMAIL=ops@example.com

# Generate secrets, for example: openssl rand -base64 32
LT_USERNAME=replace-with-account-name
LT_PASSWORD=
LT_PASSWORD_SALT=
LT_SESSION_SECRET=

LT_SESSION_TTL_HOURS=720
LT_LOG_LEVEL=info
