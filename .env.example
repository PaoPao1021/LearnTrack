# LearnTrack API 配置示例（复制为 .env 并填入真实值；绝不要提交 .env）

# 服务监听
LT_PORT=8787
LT_HOST=127.0.0.1

# 初始个人账号（必需）。生产环境使用 .env.production，绝不要提交真实密钥。
LT_USERNAME=paopao
LT_PASSWORD=change-me
LT_PASSWORD_SALT=change-me-too

# 会话签名密钥（生产环境使用长随机串）
LT_SESSION_SECRET=change-me
LT_SESSION_TTL_HOURS=720
# 本地 HTTP 为 false；生产 Docker Compose 会强制设为 true。
LT_COOKIE_SECURE=false

# 直连 API 时为 0。经本机 Nginx 或生产 Caddy 反代时设为 1。
LT_TRUST_PROXY=0

# 数据与备份目录（Docker 部署时挂载持久卷到这两个目录）
LT_DATA_DIR=./var/data
LT_BACKUP_DIR=./var/backups

LT_LOG_LEVEL=info

# 可选：学习助手。兼容 OpenAI Chat Completions / JSON object 格式。
# 只在服务器配置密钥，前端不要设置 VITE_* 密钥。
LT_AI_BASE_URL=https://api.deepseek.com
LT_AI_MODEL=deepseek-flash
LT_AI_API_KEY=

# 可选：GitHub GraphQL 贡献日历（Token 仅存在于服务器）。
LT_GITHUB_TOKEN=
