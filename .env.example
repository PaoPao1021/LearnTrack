# LearnTrack API 配置示例（复制为 .env 并填入真实值；绝不要提交 .env）

# 服务监听
LT_PORT=8787
LT_HOST=127.0.0.1

# 初始个人账号（必需）。生产环境务必修改并通过环境注入，不要写进仓库。
LT_USERNAME=paopao
LT_PASSWORD=change-me
LT_PASSWORD_SALT=change-me-too

# 会话签名密钥（生产环境使用长随机串）
LT_SESSION_SECRET=change-me
LT_SESSION_TTL_HOURS=720
# HTTPS 反代后设为 true
LT_COOKIE_SECURE=false

# 数据与备份目录（Docker 部署时挂载持久卷到这两个目录）
LT_DATA_DIR=./var/data
LT_BACKUP_DIR=./var/backups

LT_LOG_LEVEL=info
